{
  "name": "koosha-technical-atelier",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/enable-hooks.js",
    "test": "node --test tests/*.test.js",
    "test:stale-claims": "node --test tests/stale-claim-classes.test.js tests/stale-claim-rules.test.js tests/stale-claim-scan.test.js",
    "test:sweep": "node scripts/sweep-lighthouse-claims.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='scripts/**/*.js' --test-coverage-lines=85 --test-coverage-branches=85 --test-coverage-functions=85 tests/*.test.js",
    "test:e2e": "npm run stage:publication && npx playwright test",
    "check": "node --check scripts/app.js && node --check scripts/stage-publication.js && node --check scripts/sweep-lighthouse-claims.js && node --check data/projects.js",
    "scan:stale-claims": "node scripts/scan-stale-claims.js",
    "verify:bundle": "node scripts/verify-lighthouse-bundle.mjs",
    "compare:sweeps": "node scripts/compare-sweep-coverage.mjs",
    "verify": "npx --no-install vercel build --yes && npm test && npm run check && npm run test:e2e",
    "stage:publication": "node scripts/stage-publication.js",
    "preview": "npm run stage:publication && node scripts/preview-server.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "playwright": "^1.63.0"
  },
  "dependencies": {}
}
