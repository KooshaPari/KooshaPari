#!/usr/bin/env bash
# scripts/git-hooks/pre-commit
# Activated via: git config core.hooksPath scripts/git-hooks
# Skip with:    git commit --no-verify
#
# Runs the constitution's anti-pattern detector when files under scripts/
# are staged, the full test suite when files under tests/ or scripts/
# are staged, and the stale-claim scanner when Markdown is staged.
# Either gate failing aborts the commit.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [[ -z "$STAGED" ]]; then
  exit 0
fi

SCAN_SCRIPTS=0
SCAN_TESTS=0
SCAN_MARKDOWN=0
for f in $STAGED; do
  case "$f" in
    scripts/*) SCAN_SCRIPTS=1 ;;
    tests/*)   SCAN_TESTS=1 ;;
    *.md)      SCAN_MARKDOWN=1 ;;
  esac
done

FAILED=0

if [[ "$SCAN_SCRIPTS" -eq 1 ]]; then
  echo "[pre-commit] running anti-pattern detector (scripts/ staged)"
  # `set -e` is in force, so the status is captured with the `||` form.
  # A bare `cmd` followed by `status=$?` would abort the hook on the
  # first failing command and never reach the assignment.
  DETECTOR_STATUS=0
  bash scripts/anti-pattern-detector.sh || DETECTOR_STATUS=$?
  if [[ "$DETECTOR_STATUS" -eq 1 ]]; then
    echo "[pre-commit] detector found violations — fix them or use --no-verify"
    FAILED=1
  elif [[ "$DETECTOR_STATUS" -ne 0 ]]; then
    # Exit 2 is the detector's "I could not look at the tree" code — a
    # missing tool, not a finding. It is reported as its own failure so
    # the cause is not mistaken for a content problem.
    echo "[pre-commit] detector could not run (exit $DETECTOR_STATUS) — see the message above"
    FAILED=1
  fi
fi

if [[ "$SCAN_TESTS" -eq 1 || "$SCAN_SCRIPTS" -eq 1 ]]; then
  echo "[pre-commit] running test suite (tests/ or scripts/ staged)"
  if ! node --test tests/*.test.js >/dev/null 2>&1; then
    echo "[pre-commit] tests failed — fix failures or use --no-verify"
    echo "[pre-commit] (run 'node --test tests/*.test.js' for details)"
    FAILED=1
  fi
fi

# The stale-claim scanner checks whether a document's stated test count
# agrees with the suite's actual count, and whether a "complete" round
# list matches the rounds that have entries.
#
# It runs whenever Markdown is staged, because that is what it reads.
# It measures the suite itself, so it costs one extra suite run. The
# measurement is a child process that excludes the stale-claim test
# files, so the count it compares against is the count the suite
# reports.
if [[ "$SCAN_MARKDOWN" -eq 1 ]]; then
  echo "[pre-commit] running stale-claim scanner (Markdown staged)"
  if ! node scripts/scan-stale-claims.js; then
    echo "[pre-commit] stale-claim scanner found a stale claim — fix it or use --no-verify"
    echo "[pre-commit] (run 'node scripts/scan-stale-claims.js' for details)"
    FAILED=1
  fi
fi

if [[ "$FAILED" -ne 0 ]]; then
  exit 1
fi

echo "[pre-commit] ok"
